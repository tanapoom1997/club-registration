# Template for the production env file read by compose.prod.yml. On the server:
#
#   cp deploy/production.env.example deploy/production.env
#   chmod 600 deploy/production.env
#   (fill in the values below; deploy/production.env is gitignored)
#   docker compose -f compose.prod.yml --env-file deploy/production.env up -d --wait
#
# Never commit the filled-in file or paste its values anywhere: this repo is public. Keep a copy
# of the secrets outside the server (e.g. a password manager); the database cannot be opened
# without POSTGRES_PASSWORD.

# --- web (Caddy) ---
# The site's domain, e.g. club.example.com: Caddy obtains and renews its HTTPS certificate when
# the domain's DNS points at this server and ports 80 and 443 are open. :80 serves plain HTTP
# without a certificate (local tests only, never for real students).
SITE_ADDRESS=club.example.com

# --- postgres ---
POSTGRES_USER=club
POSTGRES_DB=club_registration
# Generate with: openssl rand -hex 24
# Hex only, because it is also written into DATABASE_URL below, where characters such as @ / : #
# would break the URL.
POSTGRES_PASSWORD=

# The owner of the database (POSTGRES_USER, a superuser). Only migrate connects with it, and the
# backup and restore scripts use POSTGRES_USER directly. Built from the values above (compose
# expands ${...} inside this file); "postgres" is the database service's name on the compose
# network. Leave as is.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- api ---
# The api connects as club_app, a role that may only read and write the tables the api uses
# (docs/security.md "Database role ของ api"); migrate sets its password from this value on every `up`, so
# changing it here and running `up` again rotates it. Generate with: openssl rand -hex 24
# (hex only, for the same reason as POSTGRES_PASSWORD). Must differ from POSTGRES_PASSWORD.
APP_DB_PASSWORD=
# Leave as is. The api refuses to start if this connects as the owner instead.
APP_DATABASE_URL=postgres://club_app:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Signs session tokens. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# Optional database pool settings for the api. Empty = the api's defaults (shown), which are
# estimates until the load test on the real host (O5). Keep DB_POOL_MAX well below Postgres's
# max_connections (50, compose.prod.yml).
DB_POOL_MAX=
# How long a request waits for a free pooled connection before failing with 500 (default 5000).
DB_CONNECTION_TIMEOUT_MS=
# Longest a single SQL statement may run (default 10000).
DB_STATEMENT_TIMEOUT_MS=
# Longest a transaction may sit idle while holding locks (default 10000).
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# Optional queue timeouts for the api (README Phase 3), in seconds. Empty = the api's defaults
# (shown), which are estimates until the load test on the real host (O5).
# A queue ticket (waiting or admitted) whose page has sent no heartbeat for this long expires and
# its place goes to the next student (default 60, 15-3600; the page polls every 3-5 s).
QUEUE_IDLE_TIMEOUT_SECONDS=
# How long an admitted student may keep their turn to choose clubs, heartbeats or not, before it
# goes to the next student (default 600, 60-7200).
QUEUE_ADMISSION_TTL_SECONDS=

# --- backup (scripts/backup.sh, scripts/restore.sh; docs/operations.md "Backup และ Restore") ---
# Not read by compose.prod.yml, only by the backup and restore scripts. Never commit the real
# bucket name: this repo is public.
# Where the dumps go: s3://<bucket>/<prefix>, e.g. s3://example-club-backups/prod. The bucket must
# be private (Block Public Access on), and the instance role may only list, put and get under the
# prefix (deploy/s3-backup-policy.example.json). Empty = scripts/backup.sh refuses to run unless
# given --local-only.
BACKUP_S3_URI=
# Region of the bucket, e.g. ap-southeast-1. Empty = the AWS CLI's own configuration.
BACKUP_AWS_REGION=
# Local copies, mode 700 (they hold student names and password hashes). Empty = default below.
BACKUP_DIR=/var/backups/club-registration
# How many local copies to keep (the newest). Old S3 objects are removed by the bucket's
# lifecycle rule (deploy/s3-lifecycle.example.json), not by the script.
BACKUP_KEEP_LOCAL=7
