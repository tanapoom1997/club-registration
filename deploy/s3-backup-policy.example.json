{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::example-club-backups",
      "Condition": { "StringLike": { "s3:prefix": ["prod/*"] } }
    },
    {
      "Sid": "ReadWriteBackupObjectsNoDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::example-club-backups/prod/*"
    }
  ]
}
