{
  "name": "@club-registration/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@club-registration/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod-jitless": {
      "@club-registration/source": "./src/zod-jitless.ts",
      "types": "./dist/zod-jitless.d.ts",
      "default": "./dist/zod-jitless.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "vitest": "5.1.1"
  }
}
