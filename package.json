{
  "name": "club-registration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter api migrate && pnpm --filter api seed-dev && pnpm --filter api --filter web --parallel run dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:sh": "scripts/lint-shell.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "audit:deps": "pnpm audit --audit-level high",
    "e2e": "pnpm --filter @club-registration/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
