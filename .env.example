# Local development only. Copy to .env; real secrets never belong in this file.
POSTGRES_USER=club
POSTGRES_PASSWORD=change-me
POSTGRES_DB=club_registration

DATABASE_URL=postgres://club:change-me@127.0.0.1:5432/club_registration
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

